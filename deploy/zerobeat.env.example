# /etc/zerobeat/zerobeat.env — owned root:zerobeat, mode 640.
# 32 random bytes as hex: openssl rand -hex 32. Encrypts stored credentials; keep a copy.
ZEROBEAT_SECRET_KEY=
# Shared secret between the web app and the engine: openssl rand -hex 32
ENGINE_TOKEN=
ZEROBEAT_DB=/var/lib/zerobeat/zerobeat.db
ZEROBEAT_DATA=/var/lib/zerobeat
ZEROBEAT_MIGRATIONS=/opt/zerobeat/packages/core/drizzle
ZEROBEAT_CTY=/opt/zerobeat/packages/core/data/cty.csv
NODE_ENV=production
